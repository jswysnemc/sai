{
  "api_version": 1,
  "id": "todo",
  "version": "1.0.0",
  "name": "Session todo",
  "description": "Maintain ordered session plans, archived history and progress reminders.",
  "entry": "init.lua",
  "capabilities": {"reply_policy": true, "system": {"session_storage": true, "read_paths": [".sai/todo-import"]}},
  "limits": {"memory_bytes": 16777216, "instructions": 4000000, "timeout_ms": 10000, "output_bytes": 524288, "system_calls": 128}
}
